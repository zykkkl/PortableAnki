#pragma once
// ===== WiFi 凭据模板 =====
// 用法:把本文件复制为同目录下的 secrets.h,再填入你自己的 WiFi 账号密码。
// secrets.h 已被 .gitignore 忽略,不会被提交到代码库。
#define WIFI_SSID     "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
// PC 局域网地址(和设备同一 WiFi 下电脑的 IP:端口)。
// Anki 插件 minianki_bridge 默认端口是 8766。
#define PC_HOST       "http://192.168.1.100:8766"

// ===== Anki 插件导出参数 =====
// 先在串口输入 l 查看 /decks 输出,再填 deckId;deckId > 0 时优先使用 deckId。
// 如果 ANKI_DECK_ID 为 0 且 ANKI_DECK_NAME 为空,插件会使用 Anki 当前选中的卡组。
#define ANKI_DECK_ID          0
#define ANKI_DECK_NAME        ""

// 每次从插件下载的卡片上限。0 表示不传 limit 参数。
// V1 建议设置为 64 或更小,与 MAX_SESSION_CARDS 的默认容量一致。
#define ANKI_CARD_LIMIT       64

// 是否包含子卡组;是否把导出的 due 强制改为现在(便于离线测试/携带复习)。
#define ANKI_INCLUDE_SUBDECKS 1
#define ANKI_FORCE_DUE_NOW    1
