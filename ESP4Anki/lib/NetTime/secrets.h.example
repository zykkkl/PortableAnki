// ===== WiFi 凭据模板 =====
// 用法:把本文件复制为同目录下的 secrets.h,再填入你自己的 WiFi 账号密码。
// secrets.h 已被 .gitignore 忽略,不会被提交到代码库。
#define WIFI_SSID     "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
// PC 局域网地址(和设备同一 WiFi 下电脑的 IP:端口),用于下载导入包
#define PC_HOST       "http://192.168.1.100:8000"
